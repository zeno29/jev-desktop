# Copy this file to .env and fill in your keys.

# TypeSafe (Jev): fast decision layer. Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=

# Google Gemini: fallback LLM for anything Jev routes to a model. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Spotify: play in the desktop app (needs Premium). Client ID from https://developer.spotify.com/dashboard
# (redirect URI: http://127.0.0.1:8888/callback). No client secret needed.
SPOTIFY_CLIENT_ID=

# Sarvam AI (optional): speech recognition + voices built for Indian languages and Hinglish.
# Key: https://dashboard.sarvam.ai  — when set, voice uses Sarvam first (see [voice] in config.toml).
SARVAM_API_KEY=

# Gmail inbox reading ("any important mails today?"): Jev reads your inbox over IMAP, read-only, and
# judges which emails matter. Use an app password, not your Google password: turn on 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords
# Without these, mail questions open the matching search in Gmail in Chrome instead.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
